<section class="chat-widget" data-chat-widget data-chat-endpoint="{{ url('/api/chat') }}">
  <button class="chat-widget__trigger" type="button" data-chat-trigger aria-expanded="false" aria-controls="chat-widget-panel">
    <svg class="chat-widget__trigger-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M7.5 18.5 3 21l1.25-4.75A8.4 8.4 0 0 1 3 11.85C3 6.96 7.03 3 12 3s9 3.96 9 8.85-4.03 8.85-9 8.85a9.2 9.2 0 0 1-4.5-1.2Z"></path>
      <path d="M8 11.8h.01M12 11.8h.01M16 11.8h.01"></path>
    </svg>
    <span>Pregúntanos</span>
  </button>

  <div id="chat-widget-panel" class="chat-widget__panel" data-chat-panel role="dialog" aria-labelledby="chat-widget-title" hidden>
    <header class="chat-widget__header">
      <div>
        <p class="chat-widget__eyebrow">Lar de Víes</p>
        <p id="chat-widget-title" class="chat-widget__title">¿En qué podemos ayudarte?</p>
      </div>
      <button class="chat-widget__close" type="button" data-chat-close aria-label="Cerrar asistente">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18"></path></svg>
      </button>
    </header>

    <div class="chat-widget__conversation" data-chat-conversation role="log" aria-live="polite" aria-relevant="additions">
      <div class="chat-widget__message chat-widget__message--assistant">
        <p>Hola 🌿 Soy el asistente de Lar de Víes. Puedo ayudarte con los alojamientos, la gastronomía, el entorno y cómo funciona la estancia.</p>
      </div>
    </div>

    <div class="chat-widget__suggestions" data-chat-suggestions role="group" aria-label="Preguntas sugeridas">
      <button type="button" data-chat-suggestion="¿Qué alojamiento me recomendáis?">¿Qué alojamiento me recomendáis?</button>
      <button type="button" data-chat-suggestion="¿Aceptáis perros?">¿Aceptáis perros?</button>
      <button type="button" data-chat-suggestion="¿Hay cenas?">¿Hay cenas?</button>
    </div>

    <form class="chat-widget__form" data-chat-form>
      <label class="sr-only" for="chat-widget-input">Escribe tu pregunta</label>
      <textarea id="chat-widget-input" class="chat-widget__input" data-chat-input rows="1" maxlength="500" placeholder="Escribe tu pregunta…" required></textarea>
      <button class="chat-widget__send" type="submit" data-chat-send aria-label="Enviar pregunta">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m4 12 16-8-5.5 16-3.1-6.1L4 12Z"></path><path d="M11.4 13.9 20 4"></path></svg>
      </button>
    </form>
    <p class="chat-widget__privacy">No compartas datos personales. Las respuestas pueden contener errores.</p>
    <p class="sr-only" data-chat-status aria-live="assertive"></p>
  </div>
</section>
