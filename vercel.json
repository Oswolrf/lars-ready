{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "build": {
    "env": {
      "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
    }
  },
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/otros-alojamientos/", "destination": "/rural-prado/", "statusCode": 301 },
    { "source": "/otros-alojamientos", "destination": "/rural-prado/", "statusCode": 301 },
    { "source": "/OtrosAlojamientos.html", "destination": "/rural-prado/", "statusCode": 301 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/LaCasona.html", "destination": "/la-casona/", "statusCode": 301 },
    { "source": "/LaCasona", "destination": "/la-casona/", "statusCode": 301 },
    { "source": "/Lasvillas.html", "destination": "/las-villas-casitas-independientes/", "statusCode": 301 },
    { "source": "/Lasvillas", "destination": "/las-villas-casitas-independientes/", "statusCode": 301 },
    { "source": "/OtrosAlojamientos", "destination": "/rural-prado/", "statusCode": 301 },
    { "source": "/Entorno.html", "destination": "/el-entorno/", "statusCode": 301 },
    { "source": "/Entorno", "destination": "/el-entorno/", "statusCode": 301 },
    { "source": "/Reserva.html", "destination": "/reservas/", "statusCode": 301 },
    { "source": "/Reserva", "destination": "/reservas/", "statusCode": 301 },
    { "source": "/sobre-nosotros.html", "destination": "/sobre-nosotros/", "statusCode": 301 },
    { "source": "/politica-de-privacidad.html", "destination": "/politica-privacidad/", "statusCode": 301 },
    { "source": "/aviso-legal.html", "destination": "/aviso-legal/", "statusCode": 301 },
    { "source": "/zonas-comunes.html", "destination": "/zonas-comunes/", "statusCode": 301 },
    { "source": "/suites/la-panera.html", "destination": "/suite-la-panera/", "statusCode": 301 },
    { "source": "/suites/la-panera", "destination": "/suite-la-panera/", "statusCode": 301 },
    { "source": "/suites/el-cabozo.html", "destination": "/suite-el-cabozo/", "statusCode": 301 },
    { "source": "/suites/el-cabozo", "destination": "/suite-el-cabozo/", "statusCode": 301 },
    { "source": "/suites/la-capilla.html", "destination": "/suite-la-capilla/", "statusCode": 301 },
    { "source": "/suites/la-capilla", "destination": "/suite-la-capilla/", "statusCode": 301 },
    { "source": "/suites/el-valle.html", "destination": "/suite-el-valle/", "statusCode": 301 },
    { "source": "/suites/el-valle", "destination": "/suite-el-valle/", "statusCode": 301 },
    { "source": "/suites/el-jardin.html", "destination": "/suite-el-jardin/", "statusCode": 301 },
    { "source": "/suites/el-jardin", "destination": "/suite-el-jardin/", "statusCode": 301 },
    { "source": "/villas/el-camino.html", "destination": "/villa-el-camino/", "statusCode": 301 },
    { "source": "/villas/el-camino", "destination": "/villa-el-camino/", "statusCode": 301 },
    { "source": "/villas/camelia.html", "destination": "/villa-camelia/", "statusCode": 301 },
    { "source": "/villas/camelia", "destination": "/villa-camelia/", "statusCode": 301 },
    { "source": "/villas/jazmin.html", "destination": "/villa-jazmin/", "statusCode": 301 },
    { "source": "/villas/jazmin", "destination": "/villa-jazmin/", "statusCode": 301 },
    { "source": "/como-llegar/", "destination": "/el-entorno/#como-llegar", "statusCode": 301 }
  ],
  "routes": [
    { "src": "^/excursiones-en-lugo/?$", "dest": "/410.html", "status": 410 },
    { "src": "^/blog/?$", "dest": "/410.html", "status": 410 }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://sibforms.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://maps.gstatic.com https://maps.googleapis.com; media-src 'self'; frame-src https://maps.google.com https://www.google.com; connect-src 'self' https://sibforms.com https://*.sibforms.com; form-action 'self' https://*.sibforms.com https://direct-book.com; upgrade-insecure-requests" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://sibforms.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://maps.gstatic.com https://maps.googleapis.com; media-src 'self'; frame-src https://maps.google.com https://www.google.com; connect-src 'self' https://sibforms.com https://*.sibforms.com; form-action 'self' https://*.sibforms.com https://direct-book.com; upgrade-insecure-requests" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    }
  ]
}
