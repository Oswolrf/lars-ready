{
  "name": "lars-website",
  "version": "1.0.0",
  "description": "Lar de Vies Website",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "seo:apply": "node scripts/apply_seo_updates.js",
    "seo:validate": "node scripts/validate_seo.js",
    "validate:static": "node scripts/validate_static.js",
    "validate:html": "html-validate \"public/**/*.html\"",
    "validate": "npm run seo:validate && npm run validate:static",
    "build": "npm run build:css && node scripts/build_static.js --env=production && node scripts/validate_build.js public production && npm run validate:html && node scripts/validate_acceptance.js public",
    "build:preview": "npm run build:css && node scripts/build_static.js --env=preview && node scripts/validate_build.js public preview && npm run validate:html && node scripts/validate_acceptance.js public",
    "build:vercel": "npm run build",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.js --project=chromium --workers=1",
    "audit:lighthouse": "node scripts/run_lighthouse.js",
    "media:prepare": "node scripts/media/prepare-hero-videos.js",
    "media:compare": "node scripts/media/compare-hero-videos.js",
    "seo:notify": "node scripts/notify_indexnow.js",
    "adapters:check": "node scripts/generate_adapters.js --check",
    "rag:test": "node --test tests/rag/corpus.test.js tests/rag/chat-api.test.js",
    "rag:ingest": "node --env-file-if-exists=.env.local scripts/ingest-rag.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@material-symbols/svg-400": "^0.45.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.28.2",
    "html-validate": "^10.17.0",
    "lighthouse": "^13.4.1",
    "nunjucks": "^3.2.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "ai": "7.0.85"
  }
}
