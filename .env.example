# Secrets: use .env.local locally and Vercel Environment Variables remotely.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Random value with at least 32 bytes; never expose it to browser code.
CHAT_HISTORY_SECRET=

# Optional RAG configuration.
RAG_CHAT_MODEL=gpt-5-nano
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_MIN_SIMILARITY=0.32
RAG_ALLOWED_ORIGINS=

# Public build setting for an IONOS frontend with a separate chat server.
# Leave empty for the existing same-origin deployment. Set in the shell before building.
CHAT_API_URL=
# Example backend setting: RAG_ALLOWED_ORIGINS=https://lardevies.com,https://www.lardevies.com

# Supabase Edge Functions: copy the database key into CHAT_DATABASE_KEY remotely.
# SUPABASE_URL is supplied by Supabase itself. Never send private keys to the browser.
# CHAT_API_URL=https://PROJECT_REF.supabase.co/functions/v1/chat
CHAT_GLOBAL_BURST_LIMIT=100
CHAT_GLOBAL_DAILY_LIMIT=500
