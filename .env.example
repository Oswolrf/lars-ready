# Secrets: use .env.local locally and Vercel Environment Variables remotely.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Random value with at least 32 bytes; never expose it to browser code.
CHAT_HISTORY_SECRET=

# Optional RAG configuration.
RAG_CHAT_MODEL=gpt-5-nano
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_MIN_SIMILARITY=0.32
RAG_ALLOWED_ORIGINS=
